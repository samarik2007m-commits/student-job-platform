const express = require('express');
const cors = require('cors');
const path = require('path');
const fs = require('fs');
const Database = require('better-sqlite3');
const Stripe = require('stripe');
require('dotenv').config();

const app = express();
const PORT = Number(process.env.PORT || 4000);
const FRONTEND_URL = process.env.FRONTEND_URL || 'http://localhost:5173';

const dataDir = path.join(__dirname, 'data');
if (!fs.existsSync(dataDir)) {
  fs.mkdirSync(dataDir, { recursive: true });
}

const db = new Database(path.join(dataDir, 'studentjob.db'));
db.pragma('journal_mode = WAL');

db.exec(`
  CREATE TABLE IF NOT EXISTS plans (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    price TEXT NOT NULL,
    description TEXT,
    popular INTEGER DEFAULT 0
  );

  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'student',
    company TEXT,
    plan TEXT DEFAULT 'starter',
    skills TEXT DEFAULT '[]',
    bio TEXT,
    status TEXT DEFAULT 'Активен',
    created_at INTEGER DEFAULT (strftime('%s','now'))
  );

  CREATE TABLE IF NOT EXISTS jobs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    company TEXT NOT NULL,
    city TEXT NOT NULL,
    type TEXT NOT NULL,
    category TEXT NOT NULL,
    salary TEXT NOT NULL,
    tags TEXT DEFAULT '[]',
    premium INTEGER DEFAULT 0,
    created_by INTEGER,
    created_at INTEGER DEFAULT (strftime('%s','now'))
  );

  CREATE TABLE IF NOT EXISTS applications (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    job_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    applied_at INTEGER DEFAULT (strftime('%s','now')),
    UNIQUE(job_id, user_id)
  );

  CREATE TABLE IF NOT EXISTS subscriptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    plan_id TEXT NOT NULL,
    is_active INTEGER DEFAULT 1,
    activated_at INTEGER DEFAULT (strftime('%s','now'))
  );
`);

function parseSkills(value) {
  try {
    return JSON.parse(value || '[]');
  } catch (error) {
    return [];
  }
}

function stringifySkills(skills) {
  return JSON.stringify(Array.isArray(skills) ? skills : []);
}

function parseTags(value) {
  try {
    return JSON.parse(value || '[]');
  } catch (error) {
    return [];
  }
}

function stringifyTags(tags) {
  return JSON.stringify(Array.isArray(tags) ? tags : []);
}

function seedPlans() {
  const existing = db.prepare('SELECT COUNT(*) AS count FROM plans').get();
  if (existing.count > 0) return;

  db.prepare(`
    INSERT INTO plans (id, name, price, description, popular)
    VALUES
      ('starter', 'Старт', '₽0', 'Для первых публикаций и тестового запуска', 0),
      ('pro', 'Профи', '₽1490/мес', 'Для регулярного найма и приоритета в поиске', 1),
      ('business', 'Бизнес', '₽3990/мес', 'Для компаний, которые хотят масштабировать найм', 0)
  `).run();
}

function seedUsers() {
  const count = db.prepare('SELECT COUNT(*) AS count FROM users').get();
  if (count.count > 0) return;

  db.prepare(`
    INSERT INTO users (name, email, password, role, company, plan, skills, bio, status)
    VALUES
      ('Demo Student', 'student@example.com', '123456', 'student', NULL, 'starter', ?, 'Студент IT-направления. Ищу стажировку и первые пр��екты.', 'Ищет работу'),
      ('Astra Hiring', 'employer@example.com', '123456', 'employer', 'Astra Digital', 'pro', '[]', 'Компания готова к сотрудничеству.', 'Активен'),
      ('Admin Panel', 'admin@example.com', '123456', 'admin', NULL, 'business', '[]', 'Администратор платформы.', 'Администратор')
  `).run(stringifySkills(['HTML', 'CSS', 'JavaScript', 'React']));
}

function seedJobs() {
  const count = db.prepare('SELECT COUNT(*) AS count FROM jobs').get();
  if (count.count > 0) return;

  db.prepare(`
    INSERT INTO jobs (title, company, city, type, category, salary, tags, premium, created_by)
    VALUES
      ('Junior Frontend Developer', 'Astra Digital', 'Москва', 'Полный день', 'development', 'от 80 000 ₽', ?, 1, 2),
      ('Marketing Intern', 'Bright Media', 'Санкт-Петербург', 'Удалённо', 'marketing', 'от 45 000 ₽', ?, 0, 2),
      ('UI/UX Designer', 'Pixel Studio', 'Казань', 'Стажировка', 'design', 'от 50 000 ₽', ?, 1, 2),
      ('Finance Analyst Intern', 'NovaCapital', 'Новосибирск', 'Частичная занятость', 'finance', 'от 60 000 ₽', ?, 0, 2),
      ('Customer Support Specialist', 'HelioCare', 'Екатеринбург', 'Удалённо', 'support', 'от 42 000 ₽', ?, 0, 2),
      ('Backend Trainee', 'CoreStack', 'Москва', 'Тестовый проект', 'development', 'от 70 000 ₽', ?, 1, 2)
  `).run(
    stringifyTags(['React', 'JavaScript', 'Remote']),
    stringifyTags(['SMM', 'SEO', 'Analytics']),
    stringifyTags(['Figma', 'UX', 'Research']),
    stringifyTags(['Excel', 'Finance', 'Data']),
    stringifyTags(['Support', 'Chat', 'Client']),
    stringifyTags(['Node.js', 'API', 'SQL'])
  );
}

seedPlans();
seedUsers();
seedJobs();

app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '2mb' }));

function getUserSafe(user) {
  if (!user) return null;
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    role: user.role,
    company: user.company || '',
    plan: user.plan || 'starter',
    skills: parseSkills(user.skills),
    bio: user.bio || '',
    status: user.status || 'Активен'
  };
}

function getJobRow(row) {
  return {
    id: row.id,
    title: row.title,
    company: row.company,
    city: row.city,
    type: row.type,
    category: row.category,
    salary: row.salary,
    tags: parseTags(row.tags),
    premium: !!row.premium,
    created_by: row.created_by,
    createdAt: row.created_at * 1000
  };
}

app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', message: 'StudentJob production API is running' });
});

app.get('/api/plans', (req, res) => {
  const plans = db.prepare('SELECT id, name, price, description, popular FROM plans ORDER BY id').all();
  res.json(plans.map((plan) => ({
    id: plan.id,
    name: plan.name,
    price: plan.price,
    description: plan.description,
    features: {
      starter: ['1 активная вакансия', 'Базовый профиль', 'Личный кабинет'],
      pro: ['10 вакансий', 'Приоритет в выдаче', 'Уведомления о заявках'],
      business: ['Неограниченные вакансии', 'Экспорт заявок', 'VIP-поддержка']
    }[plan.id] || [],
    popular: !!plan.popular
  })));
});

app.get('/api/stats', (req, res) => {
  const users = db.prepare('SELECT role FROM users').all();
  const jobs = db.prepare('SELECT id, premium FROM jobs').all();
  const apps = db.prepare('SELECT COUNT(*) AS count FROM applications').get();
  const subscriptions = db.prepare('SELECT COUNT(*) AS count FROM subscriptions WHERE is_active = 1').get();

  res.json({
    jobsTotal: jobs.length,
    students: users.filter((user) => user.role === 'student').length,
    employers: users.filter((user) => user.role === 'employer').length,
    admins: users.filter((user) => user.role === 'admin').length,
    applications: apps.count,
    premiumJobs: jobs.filter((job) => Number(job.premium) === 1).length,
    activeSubscriptions: subscriptions.count
  });
});

app.get('/api/jobs', (req, res) => {
  const rows = db.prepare(`
    SELECT * FROM jobs
    ORDER BY created_at DESC
  `).all();

  res.json(rows.map(getJobRow));
});

app.get('/api/jobs/:id/applicants', (req, res) => {
  const jobId = Number(req.params.id);
  const job = db.prepare('SELECT id FROM jobs WHERE id = ?').get(jobId);
  if (!job) return res.status(404).json({ message: 'Вакансия не найдена' });

  const apps = db.prepare(`
    SELECT * FROM applications WHERE job_id = ? ORDER BY applied_at DESC
  `).all(jobId);

  res.json(apps.map((app) => ({
    id: app.id,
    userId: app.user_id,
    name: app.name,
    email: app.email,
    appliedAt: app.applied_at * 1000
  })));
});

app.post('/api/register', (req, res) => {
  const { name, email, password, role = 'student', company } = req.body;

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Необходимо заполнить имя, email и пароль' });
  }

  const existing = db.prepare('SELECT id FROM users WHERE LOWER(email) = LOWER(?)').get(String(email));
  if (existing) {
    return res.status(409).json({ message: 'Пользователь с таким email уже существует' });
  }

  const safeRole = ['student', 'employer', 'admin'].includes(role) ? role : 'student';
  const result = db.prepare(`
    INSERT INTO users (name, email, password, role, company, plan, skills, bio, status)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    String(name),
    String(email),
    String(password),
    safeRole,
    safeRole === 'employer' ? (company || 'Моя компания') : null,
    'starter',
    stringifySkills(safeRole === 'student' ? ['HTML', 'CSS'] : []),
    safeRole === 'student' ? 'Новый студент, ищущий возможности для развития.' : 'Компания готова к сотрудничеству.',
    safeRole === 'student' ? 'Ищет работу' : 'Активен'
  );

  const user = db.prepare('SELECT * FROM users WHERE id = ?').get(result.lastInsertRowid);
  res.status(201).json({
    message: 'Регистрация успешна',
    user: getUserSafe(user)
  });
});

app.post('/api/login', (req, res) => {
  const { email, password } = req.body;

  if (!email || !password) {
    return res.status(400).json({ message: 'Email и пароль обязательны' });
  }

  const user = db.prepare(`
    SELECT * FROM users WHERE LOWER(email) = LOWER(?) AND password = ?
  `).get(String(email), String(password));

  if (!user) {
    return res.status(401).json({ message: 'Неверный email или пароль' });
  }

  res.json({
    message: 'Успешный вход',
    user: getUserSafe(user)
  });
});

app.post('/api/subscriptions/activate', (req, res) => {
  const { userId, planId } = req.body;
  if (!userId || !planId) {
    return res.status(400).json({ message: 'Не хватает данных для активации подписки' });
  }

  const allowedPlans = ['starter', 'pro', 'business'];
  if (!allowedPlans.includes(planId)) {
    return res.status(400).json({ message: 'Неверный тариф' });
  }

  const user = db.prepare('SELECT * FROM users WHERE id = ?').get(Number(userId));
  if (!user) {
    return res.status(404).json({ message: 'Пользователь не найден' });
  }

  db.prepare('UPDATE users SET plan = ?, status = ? WHERE id = ?').run(planId, 'Активен', Number(userId));
  db.prepare(`
    INSERT INTO subscriptions (user_id, plan_id, is_active, activated_at)
    VALUES (?, ?, 1, ?)
  `).run(Number(userId), planId, Math.floor(Date.now() / 1000));

  const updatedUser = db.prepare('SELECT * FROM users WHERE id = ?').get(Number(userId));
  res.json({
    message: 'Подписка успешно активирована',
    user: getUserSafe(updatedUser)
  });
});

app.post('/api/jobs', (req, res) => {
  const { title, company, city, type, category, salary, tags, createdBy, plan = 'starter' } = req.body;

  if (!title || !city || !type || !category || !salary || !createdBy) {
    return res.status(400).json({ message: 'Заполните все обязательные поля' });
  }

  const user = db.prepare('SELECT * FROM users WHERE id = ?').get(Number(createdBy));
  if (!user || !['employer', 'admin'].includes(user.role)) {
    return res.status(403).json({ message: 'Только работодатель или администратор может создавать вакансии' });
  }

  const premium = ['pro', 'business'].includes(plan) || ['pro', 'business'].includes(user.plan) ? 1 : 0;
  const result = db.prepare(`
    INSERT INTO jobs (title, company, city, type, category, salary, tags, premium, created_by, created_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).run(
    String(title),
    String(company || user.company || 'Компания'),
    String(city),
    String(type),
    String(category),
    String(salary),
    stringifyTags(Array.isArray(tags) ? tags : String(tags || '').split(',').map((t) => t.trim()).filter(Boolean)),
    premium,
    Number(createdBy),
    Math.floor(Date.now() / 1000)
  );

  const job = db.prepare('SELECT * FROM jobs WHERE id = ?').get(result.lastInsertRowid);
  res.status(201).json(getJobRow(job));
});

app.delete('/api/jobs/:id', (req, res) => {
  const jobId = Number(req.params.id);
  const job = db.prepare('SELECT id FROM jobs WHERE id = ?').get(jobId);
  if (!job) {
    return res.status(404).json({ message: 'Вакансия не найдена' });
  }

  db.prepare('DELETE FROM applications WHERE job_id = ?').run(jobId);
  db.prepare('DELETE FROM jobs WHERE id = ?').run(jobId);
  res.json({ success: true, message: 'Вакансия удалена' });
});

app.post('/api/jobs/:id/apply', (req, res) => {
  const jobId = Number(req.params.id);
  const userId = Number(req.body.userId);

  if (!userId) {
    return res.status(400).json({ message: 'Необходим userId' });
  }

  const user = db.prepare('SELECT * FROM users WHERE id = ?').get(userId);
  if (!user || user.role !== 'student') {
    return res.status(403).json({ message: 'Подать заявку могу�� только студенты' });
  }

  const job = db.prepare('SELECT * FROM jobs WHERE id = ?').get(jobId);
  if (!job) {
    return res.status(404).json({ message: 'Вакансия не найдена' });
  }

  const existing = db.prepare('SELECT id FROM applications WHERE job_id = ? AND user_id = ?').get(jobId, userId);
  if (existing) {
    return res.status(409).json({ message: 'Вы уже откликались на эту вакансию' });
  }

  db.prepare(`
    INSERT INTO applications (job_id, user_id, name, email, applied_at)
    VALUES (?, ?, ?, ?, ?)
  `).run(jobId, userId, user.name, user.email, Math.floor(Date.now() / 1000));

  const count = db.prepare('SELECT COUNT(*) AS count FROM applications WHERE job_id = ?').get(jobId);
  res.json({
    success: true,
    message: 'Отклик успешно отправлен',
    applicantsCount: count.count
  });
});

app.post('/api/checkout', async (req, res) => {
  const { planId } = req.body;
  const { STRIPE_SECRET_KEY } = process.env;

  if (!planId) {
    return res.status(400).json({ message: 'Необходим planId' });
  }

  if (!STRIPE_SECRET_KEY) {
    return res.json({
      demo: true,
      mode: 'demo',
      url: `${FRONTEND_URL}/dashboard?plan=${planId}`,
      message: 'Stripe не настроен — режим демо активирован'
    });
  }

  const stripe = new Stripe(STRIPE_SECRET_KEY);
  const planMap = {
    starter: { price: 0, name: 'Старт' },
    pro: { price: 1490, name: 'Профи' },
    business: { price: 3990, name: 'Бизнес' }
  };

  const plan = planMap[planId];
  if (!plan) {
    return res.status(400).json({ message: 'Неверный planId' });
  }

  try {
    const session = await stripe.checkout.sessions.create({
      mode: 'payment',
      line_items: [{
        quantity: 1,
        price_data: {
          currency: 'rub',
          product_data: { name: `${plan.name} — StudentJob` },
          unit_amount: plan.price * 100
        }
      }],
      success_url: `${FRONTEND_URL}/dashboard?checkout=success`,
      cancel_url: `${FRONTEND_URL}/dashboard?checkout=cancelled`,
      metadata: { planId }
    });

    res.json({ url: session.url, demo: false, mode: 'stripe' });
  } catch (error) {
    res.status(500).json({ message: 'Ошибка Stripe checkout', detail: error.message });
  }
});

app.listen(PORT, () => {
  console.log(`StudentJob production API running at http://localhost:${PORT}`);
});

module.exports = app;

